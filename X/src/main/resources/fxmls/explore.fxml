<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="client.controllers.ExploreController"
            prefHeight="400.0" prefWidth="600.0">

    <HBox>
        <Button fx:id="returnBTN" text="return icon" onAction="#Return"/>
        <TextField fx:id="searchText" promptText="Search"/>
        <Button text="search icon" onAction="#search"/>
    </HBox>

    <VBox>
        <VBox fx:id="trendingHashtags">
            <VBox>
                <Label text="Trending hashtags"/>
            </VBox>
        </VBox>
        <VBox fx:id="resultsContainer"/>
    </VBox>

</VBox>
