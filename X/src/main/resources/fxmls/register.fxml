<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.controllers.AuthController"
      alignment="CENTER" spacing="20">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="(?)"/>

    <Label text="Enter your email:"/>

    <TextField fx:id="emailField" promptText="your email"/>

    <Label text="Choose your username and password:"/>

    <TextField fx:id="usernameField" promptText="your username"/>

    <TextField fx:id="passwordField" promptText="your password"/>

    <TextArea fx:id="registerError"/>

    <Button onAction="#signup" text="Sign up"/>

    <Label text="Already have an account?"/>

    <Button onAction="#switchScene" text="Log in"/>

</VBox>
