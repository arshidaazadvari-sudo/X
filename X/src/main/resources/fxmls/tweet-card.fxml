<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.image.ImageView?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="CONTROLLER_NAME"
      prefHeight="400.0" prefWidth="600.0">

    <ImageView fx:id="profilePicture" onMouseClicked="#">
        <clip>
            <Circle centerX="24" centerY="24" radius="24"/>
        </clip>
    </ImageView>

    <VBox>

        <HBox>
            <TextFlow fx:id="userData"/>
            <Button fx:id="followBTN" onAction="#"/>
        </HBox>

        <TextFlow fx:id="tweetText"/>

        <HBox>
            <Button fx:id="reply" onAction="#"/>
            <Label fx:id="replyCount"/>

            <Button fx:id="repost" onAction="#"/>
            <Label fx:id="repostCount"/>

            <Button fx:id="like" onAction="#"/>
            <Label fx:id="likeCount"/>

            <!-- other possible buttons -->
        </HBox>

    </VBox>

</HBox>
