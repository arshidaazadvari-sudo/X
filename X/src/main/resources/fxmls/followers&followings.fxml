<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="client.controllers.FollowController"
            prefHeight="400.0" prefWidth="600.0">

    <HBox>
        <Button text="return icon" onAction="#goToProfile"/>
        <Button fx:id="followersBTN" text="Followers" onAction="#followers"/>
        <Button fx:id="followingsBTN" text="Following" onAction="#following"/>
    </HBox>

    <VBox fx:id="usersContainer"/>

</VBox>
