<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.controllers.AuthController"
      alignment="CENTER" spacing="20" maxWidth="500" maxHeight="750" styleClass="box">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <ImageView fx:id="xLogo" preserveRatio="true" fitWidth="150" fitHeight="150"/>

    <Label text="Welcome to X" styleClass="header-t"/>

    <Label fx:id="emailText" text="Enter your email:" styleClass="primary-t"/>

    <TextField fx:id="emailField" promptText="your email" styleClass="regular-tf" maxWidth="460"/>

    <Label text="Enter your username and password:" styleClass="primary-t"/>

    <TextField fx:id="usernameField" promptText="your username" styleClass="regular-tf" maxWidth="460"/>

    <TextField fx:id="passwordField" promptText="your password" styleClass="regular-tf" maxWidth="460"/>

    <TextArea fx:id="error" styleClass="error-t" maxWidth="460"/>

    <Button fx:id="AuthBTN" onAction="#authentication" text="Login" styleClass="big-filled-btn"/>

    <Label fx:id="switchPageText" text="New to X?" styleClass="secondary-t"/>

    <Button fx:id="switchPageBTN" onAction="#switchPage" text="Sign up" styleClass="secondary-btn"/>

</VBox>
