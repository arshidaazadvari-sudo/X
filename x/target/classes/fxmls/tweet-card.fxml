<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.controllers.TweetController"
      prefHeight="400.0" prefWidth="600.0" onMouseClicked="#tweetPage" onMouseEntered="#MEntered" onMouseDragExited="#MExited">

    <TextFlow fx:id="replyToText">
        <Text fx:id="replyToUsername" styleClass="secondary-t"/>
        <Text text="See the tweet" onMouseClicked="#showRepliedTweet" styleClass="secondary-btn"/>
    </TextFlow>

    <HBox>

        <ImageView fx:id="profilePicture" onMouseClicked="#profile" preserveRatio="true">
            <clip>
                <Circle centerX="22" centerY="22" radius="22"/>
            </clip>
        </ImageView>

        <VBox>

            <HBox>
                <TextFlow>
                    <Text fx:id="name" onMouseClicked="#profile" styleClass="primary-t" style="-fx-font-weight: bold;"/>
                    <Text fx:id="username" onMouseClicked="#profile" styleClass="secondary-t"/>
                    <Text fx:id="postingDate"/>
                </TextFlow>
                <Button fx:id="followBTN" onAction="#follow" text="Follow" styleClass="small-filled-btn"/>
                <Button fx:id="deleteBTN" onAction="#delete" text="delete icon" styleClass="delete-btn"/>
            </HBox>

            <TextFlow fx:id="tweetText" styleClass="primary-t"/>

            <HBox fx:id="mediaBox"/>

            <HBox>
                <Button onAction="#reply" text="reply icon" styleClass="gray-reply-btn"/>
                <Label fx:id="replyCount" styleClass="secondary-t"/>

                <Button fx:id="repost" onAction="#repost" text="repost icon" styleClass="gray-repost-btn"/>
                <Label fx:id="repostCount" styleClass="secondary-t"/>

                <Button fx:id="like" onAction="#like" text="like icon" styleClass="gray-like-btn"/>
                <Label fx:id="likeCount" styleClass="secondary-t"/>
            </HBox>

        </VBox>

    </HBox>

</VBox>
