<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      alignment="TOP_CENTER"
      minHeight="100.0" prefWidth="600.0" maxWidth="600" styleClass="box">

    <HBox maxWidth="600" alignment="TOP_CENTER">
        <Button fx:id="returnBTN" onAction="#Return" styleClass="small-hollow-btn" maxWidth="50">
            <graphic>
                <FontIcon fx:id="returnIcon" iconSize="24" styleClass="primary-icon"/>
            </graphic>
        </Button>
        <TextField fx:id="searchText" promptText="Search" styleClass="regular-tf" prefWidth="480"/>
        <Button onAction="#search" styleClass="small-hollow-btn" maxWidth="50">
            <graphic>
                <FontIcon fx:id="searchIcon" iconSize="24" styleClass="primary-icon"/>
            </graphic>
        </Button>
    </HBox>

    <VBox maxWidth="600">
        <VBox fx:id="trendingHashtags">
            <VBox prefHeight="100" spacing="150" alignment="CENTER_LEFT">
                <padding>
                    <Insets left="50"/>
                </padding>
                <Label text="Trending hashtags" styleClass="header-t"/>
            </VBox>
            <!-- hashtags -->
        </VBox>
        <VBox fx:id="resultsContainer"/>
    </VBox>

</VBox>
