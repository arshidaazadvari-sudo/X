<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>

<?import javafx.scene.shape.Rectangle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.controllers.ProfileController"
      alignment="TOP_CENTER" spacing="20" styleClass="box">
    <BorderPane>

        <center>
            <VBox spacing="20">
                <StackPane prefHeight="270" maxWidth="600">

                    <ImageView fx:id="banner" preserveRatio="true" fitHeight="200" fitWidth="600" StackPane.alignment="TOP_CENTER"/>

                    <ImageView fx:id="profile" preserveRatio="true" fitHeight="134" fitWidth="134" StackPane.alignment="BOTTOM_LEFT">
                        <clip>
                            <Circle centerX="65" centerY="65" radius="65"/>
                        </clip>
                    </ImageView>

                    <HBox fx:id="btnBox" StackPane.alignment="BOTTOM_RIGHT" alignment="CENTER" maxWidth="80" maxHeight="35">
                        <Button fx:id="editProfileBTN" onAction="#editProfile" text="Edit profile" styleClass="small-bordered-btn"/>
                        <Button fx:id="followBTN" onAction="#follow" text="Follow" styleClass="small-filled-btn"/>
                    </HBox>

                </StackPane>

                <VBox spacing="5" alignment="CENTER_LEFT" prefHeight="150">
                    <padding>
                        <Insets left="30"/>
                    </padding>
                    <Label fx:id="displayName" styleClass="header-t"/>
                    <Label fx:id="username" styleClass="secondary-t"/>
                    <Label fx:id="bio" styleClass="primary-t" wrapText="true"/>
                    <Label fx:id="dateOfJoining" styleClass="secondary-t" graphicTextGap="8">
                        <graphic>
                            <FontIcon fx:id="joiningDateIcon" iconSize="18" styleClass="secondary-icon"/>
                        </graphic>
                    </Label>
                    <HBox spacing="10" alignment="BOTTOM_LEFT" prefHeight="50" prefWidth="300">
                        <Label fx:id="tweetsCount" styleClass="secondary-t"/>
                        <Label fx:id="FollowingBTN" onMouseClicked="#displayFollowings" styleClass="secondary-btn"/>
                        <Label fx:id="FollowerBTN" onMouseClicked="#displayFollowers" styleClass="secondary-btn"/>
                    </HBox>
                </VBox>

                <HBox spacing="100" alignment="BOTTOM_CENTER">

                    <VBox alignment="BOTTOM_CENTER">
                        <Button onAction="#displayPosts" text="Posts" styleClass="big-hollow-btn"/>
                        <Rectangle fx:id="pIndicator" width="80" height="4" arcWidth="8" arcHeight="8" styleClass="indicator-line"/>
                    </VBox>

                    <VBox alignment="BOTTOM_CENTER">
                        <Button onAction="#displayReplies" text="Replies" styleClass="big-hollow-btn"/>
                        <Rectangle fx:id="rIndicator" width="80" height="4" arcWidth="8" arcHeight="8" styleClass="indicator-line"/>
                    </VBox>

                    <VBox alignment="BOTTOM_CENTER">
                        <Button onAction="#displayMedia" text="Media" styleClass="big-hollow-btn"/>
                        <Rectangle fx:id="mIndicator" width="80" height="4" arcWidth="8" arcHeight="8" styleClass="indicator-line"/>
                    </VBox>

                </HBox>

                <HBox fx:id="noPosts" managed="false" visible="false" prefHeight="100" alignment="CENTER">
                    <Label text="No posts yet " styleClass="header-t"/>
                </HBox>

                <VBox fx:id="tweetsContainer"/>
            </VBox>
        </center>
    </BorderPane>

</VBox>