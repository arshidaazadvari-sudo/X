<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="client.controllers.MainController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox fillHeight="false">

        <VBox fillWidth="false" spacing="30" prefWidth="250" maxWidth="250">

            <ImageView fx:id="xLogo1" preserveRatio="true" fitHeight="120" fitWidth="120"/>

            <Button onAction="#Home" text="Home" styleClass="big-hollow-btn" style="-fx-font-size: 20px;" graphicTextGap="8">
                <graphic>
                    <FontIcon fx:id="home" iconSize="32" styleClass="primary-icon"/>
                </graphic>
            </Button>

            <Button onAction="#Explore" text="Explore" styleClass="big-hollow-btn" style="-fx-font-size: 20px;" graphicTextGap="8">
                <graphic>
                    <FontIcon fx:id="explore" iconSize="32" styleClass="primary-icon"/>
                </graphic>
            </Button>

            <Button onAction="#Profile" text="Profile" styleClass="big-hollow-btn" style="-fx-font-size: 20px;" graphicTextGap="8">
                <graphic>
                    <FontIcon fx:id="profile" iconSize="32" styleClass="primary-icon"/>
                </graphic>
            </Button>

            <Button onAction="#PostWindow" text="Post" styleClass="big-filled-btn" style="-fx-font-size: 20px; -fx-padding: 12 72;"/>

            <HBox fillHeight="false" spacing="30" prefWidth="200">
                <Button onAction="#LogoutWindow" styleClass="big-hollow-btn">
                    <graphic>
                        <FontIcon fx:id="logoutIcon" iconSize="32" styleClass="primary-icon"/>
                    </graphic>
                </Button>
                <Button onAction="#toggleTheme" styleClass="big-hollow-btn">
                    <graphic>
                        <FontIcon fx:id="toggle" iconSize="32" styleClass="primary-icon"/>
                    </graphic>
                </Button>
            </HBox>

        </VBox>

        <ScrollPane prefWidth="650" maxWidth="650" minHeight="750" fitToWidth="true" styleClass="scroll-pane">
            <VBox fx:id="container" maxWidth="600" minHeight="0" prefWidth="600" alignment="CENTER"/>
        </ScrollPane>

    </HBox>

    <Pane fx:id="overlay1" visible="false" managed="false" styleClass="overlay" prefWidth="-Infinity" prefHeight="-Infinity"/>

    <VBox fx:id="editWindow" styleClass="window" visible="false" managed="false" maxWidth="650" maxHeight="650" alignment="CENTER" spacing="20">
        <padding>
            <Insets top="20" left="20" right="20" bottom="20"/>
        </padding>
        <HBox spacing="20" maxWidth="600" maxHeight="70" VBox.vgrow="NEVER" alignment="TOP_CENTER">
            <Button onAction="#closeEditWindow" styleClass="small-hollow-btn" maxWidth="50">
                <graphic>
                    <FontIcon fx:id="editCloseIcon" iconSize="24" styleClass="primary-icon"/>
                </graphic>
            </Button>
            <Label text="Edit profile" styleClass="header-t" prefWidth="400" maxWidth="400"/>
            <Button onAction="#saveChanges" text="save" styleClass="small-filled-btn" maxWidth="70"/>
        </HBox>

        <StackPane maxWidth="600" maxHeight="260" VBox.vgrow="ALWAYS">

            <ImageView fx:id="bannerPic" preserveRatio="true" fitHeight="200" fitWidth="600" StackPane.alignment="TOP_CENTER"/>
            <Button onAction="#chooseBannerPic" styleClass="small-hollow-btn" StackPane.alignment="TOP_CENTER" translateY="80">
                <graphic>
                    <FontIcon fx:id="bannerCameraIcon" iconSize="18" styleClass="half-transparent-icon"/>
                </graphic>
            </Button>

            <ImageView fx:id="profilePic" preserveRatio="true" fitHeight="120" fitWidth="120" StackPane.alignment="BOTTOM_LEFT" translateX="20">
                <clip>
                    <Circle centerX="60" centerY="60" radius="60"/>
                </clip>
            </ImageView>
            <Button onAction="#chooseProfilePic" styleClass="small-hollow-btn" StackPane.alignment="BOTTOM_LEFT" translateX="50" translateY="-30">
                <graphic>
                    <FontIcon fx:id="profileCameraIcon" iconSize="18" styleClass="half-transparent-icon"/>
                </graphic>
            </Button>

        </StackPane>

        <VBox spacing="20" maxHeight="200" maxWidth="550" VBox.vgrow="NEVER">
            <VBox spacing="10" maxHeight="80" maxWidth="500">
                <Label text="Name" styleClass="secondary-t"/>
                <TextField fx:id="newDisplayName" styleClass="edit-tf"/>
                <Label fx:id="blankNameMSG" text="Name can't be blank" visible="false" styleClass="blank-name-t"/>
            </VBox>

            <VBox spacing="10" maxHeight="80" maxWidth="500">
                <Label text="Bio" styleClass="secondary-t"/>
                <TextArea fx:id="newBio" styleClass="edit-tf" wrapText="true"/>
            </VBox>
        </VBox>

    </VBox>

    <Pane fx:id="overlay2" visible="false" managed="false" styleClass="overlay" minHeight="-Infinity" minWidth="-Infinity"/>

    <VBox fx:id="discardWindow" visible="false" managed="false" styleClass="window" alignment="CENTER" spacing="20" maxHeight="300" maxWidth="300">
        <padding>
            <Insets right="20" bottom="20" left="20" top="20"/>
        </padding>
        <Label text="Discard changes?" styleClass="header-t"/>
        <Label text="This can’t be undone and you’ll lose your changes. " maxWidth="250" wrapText="true" styleClass="secondary-t"/>
        <Button text="Discard" onAction="#discard" styleClass="red-btn"/>
        <Button text="Cancel" onAction="#cancelDiscard" styleClass="big-bordered-btn"/>
    </VBox>

    <Pane fx:id="overlay3" visible="false" managed="false" styleClass="overlay" minWidth="-Infinity" minHeight="-Infinity"/>

    <VBox fx:id="postWindow" visible="false" managed="false" spacing="30" alignment="TOP_CENTER" maxWidth="600" maxHeight="500" prefHeight="300" styleClass="window">

        <padding>
            <Insets top="20" left="20" bottom="20" right="20"/>
        </padding>

        <HBox maxWidth="550" alignment="CENTER_LEFT">
            <Button onAction="#closePostWindow" styleClass="small-hollow-btn">
                <graphic>
                    <FontIcon fx:id="postCloseIcon" iconSize="24" styleClass="primary-icon"/>
                </graphic>
            </Button>
        </HBox>

        <HBox fx:id="replyingTo" spacing="30" maxHeight="200" maxWidth="500" alignment="CENTER_LEFT">

            <padding>
                <Insets left="20"/>
            </padding>

            <ImageView fx:id="R_ProfilePic" preserveRatio="true" fitHeight="44" fitWidth="44">
                <clip>
                    <Circle centerX="22" centerY="22" radius="22"/>
                </clip>
            </ImageView>

            <VBox maxWidth="400" maxHeight="180">
                <TextFlow>
                    <Text fx:id="R_name" styleClass="primary-t" style="-fx-font-weight: bold;"/>
                    <Text fx:id="R_username" styleClass="secondary-t"/>
                    <Text fx:id="R_postingDate" styleClass="secondary-t"/>
                </TextFlow>
                <Label fx:id="R_tweetText" styleClass="primary-t" wrapText="true"/>
            </VBox>

        </HBox>

        <HBox maxWidth="550" maxHeight="300" prefHeight="200" spacing="20">
            <ImageView fx:id="miniProfilePic" preserveRatio="true" fitWidth="44" fitHeight="44">
                <clip>
                    <Circle centerX="22" centerY="22" radius="22"/>
                </clip>
            </ImageView>
            <TextArea fx:id="postText" promptText="What's happening? " styleClass="post-ta" wrapText="true" />
        </HBox>

        <HBox fx:id="mediaBox" prefHeight="300" prefWidth="500" maxHeight="300" maxWidth="500"/>

        <HBox alignment="CENTER" spacing="300" maxWidth="500" maxHeight="70">
            <Button onAction="#Media" styleClass="small-hollow-btn">
                <graphic>
                    <FontIcon fx:id="mediaIcon" iconSize="24" styleClass="primary-icon"/>
                </graphic>
            </Button>
            <Button fx:id="postBTN" onAction="#Post" text="Post" styleClass="small-filled-btn"/>
        </HBox>

    </VBox>

    <Pane fx:id="overlay4" visible="false" managed="false" styleClass="overlay" minHeight="-Infinity" minWidth="-Infinity"/>

    <VBox fx:id="deleteWindow" visible="false" managed="false" styleClass="window" alignment="CENTER" spacing="20" maxWidth="300" maxHeight="300">
        <padding>
            <Insets right="20" bottom="20" left="20" top="20"/>
        </padding>
        <Label text="Delete post?" styleClass="header-t"/>
        <Label text="This can’t be undone and it will be removed from your profile, the timeline of any accounts that follow you, and from search results. " wrapText="true" maxWidth="250" styleClass="secondary-t"/>
        <Button text="Delete" onAction="#delete" styleClass="red-btn"/>
        <Button text="Cancel" onAction="#cancelDelete" styleClass="big-bordered-btn"/>
    </VBox>

    <Pane fx:id="overlay5" visible="false" managed="false" styleClass="overlay" minWidth="-Infinity" minHeight="-Infinity"/>

    <VBox fx:id="logoutWindow" visible="false" managed="false" alignment="CENTER" styleClass="window" spacing="20" maxWidth="300" maxHeight="400">
        <padding>
            <Insets right="20" bottom="20" left="20" top="20"/>
        </padding>
        <ImageView fx:id="xLogo2" preserveRatio="true" fitHeight="150" fitWidth="150"/>
        <Label text="Log out of X?" styleClass="header-t"/>
        <Label text="You can always log back in at any time." styleClass="secondary-t" wrapText="true"/>
        <Button text="Log out" onAction="#logout" styleClass="big-filled-btn"/>
        <Button text="Cancel" onAction="#cancelLogout" styleClass="big-bordered-btn"/>
    </VBox>

    <Pane fx:id="overlay6" onMouseClicked="#closeFullsizeImage" visible="false" managed="false" styleClass="overlay" minHeight="-Infinity" minWidth="-Infinity"/>

    <ImageView fx:id="fullsizeImage" preserveRatio="true" fitHeight="700" fitWidth="800" visible="false" managed="false"/>

</StackPane>
